---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import PromoBanners from '../components/home/PromoBanners.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import ProductosPorFamilia from '../components/home/ProductosPorFamilia.astro';
import BlogBanner from '../components/home/BlogBanner.astro';
import ContactSection from '../components/home/ContactSection.astro';
import Nosotros from '../components/home/Nosotros.astro';
import Caracteristicas from '../components/home/Caracteristicas.astro';
import Comentarios from '../components/home/Comentarios.astro';
import { getHome } from '../lib/api';
import { categoriesFallback } from '../data/categories';
import type { WebTestimonio } from '../lib/types/web';

const home = await getHome();
const meta = home?.meta ?? null;
const bloques = home?.bloques ?? {};
const familias = home?.familias ?? [];
const testimoniosApi = home?.testimonios ?? [];

const AVATAR_COLORS = ['#4285F4', '#8B7355', '#34A853', '#9B8EC4', '#EA4335', '#FBBC05'];

function mapTestimonios(list: WebTestimonio[]) {
  return list.map((t, i) => {
    const name = (t.nombre || 'Cliente').toUpperCase();
    return {
      name,
      initial: name.charAt(0),
      color: AVATAR_COLORS[i % AVATAR_COLORS.length],
      text: t.comentario || '',
    };
  });
}

const categoryItemsFromApi = familias
  .filter((f) => f.slug)
  .map((f) => ({
    title: f.nombre,
    href: `/familias/${f.slug}`,
    imageUrl: f.url || undefined,
  }));

/** CRM primero; si no hay familias web, usa las 6 del Figma */
const categoryItems =
  categoryItemsFromApi.length > 0
    ? categoryItemsFromApi
    : categoriesFallback.map((c) => ({
        title: c.title,
        href: c.href,
        image: c.image,
      }));

const reviews = testimoniosApi.length ? mapTestimonios(testimoniosApi) : [];

/** Familias con productos publicados (vista detallada en escritorio). */
const familiasConProductos = familias.filter((f) => (f.productos?.length ?? 0) > 0);
const hayProductos = familiasConProductos.length > 0;

const hasAnyContent =
  Boolean(bloques.hero?.url) ||
  Boolean(bloques.promo_catalogo?.url) ||
  categoryItems.length > 0 ||
  hayProductos ||
  Boolean(bloques.blog_banner) ||
  Boolean(bloques.nosotros) ||
  Boolean(bloques.caracteristicas) ||
  reviews.length > 0 ||
  Boolean(bloques.contacto);
---

<Layout
  title={meta?.seo_title || 'CIMAK Perú'}
  description={meta?.seo_description || undefined}
  keywords={meta?.seo_keywords || undefined}
  image={meta?.og_image || undefined}
  canonical={meta?.canonical || undefined}
>
  <main>
    <div class="hero-parallax-scene" data-hero-parallax>
      <div class="hero-parallax-scene__rail">
        <div class="hero-parallax-scene__viewport">
          <Hero bloque={bloques.hero} />
          <div class="hero-parallax-scene__sheet" data-hero-sheet>
            <PromoBanners />
          </div>
        </div>
      </div>
    </div>
    <CategoryGrid items={categoryItems} />
    {hayProductos && (
      <div class="hidden md:block">
        <ProductosPorFamilia familias={familiasConProductos} />
      </div>
    )}
    <BlogBanner bloque={bloques.blog_banner} />
    <Nosotros bloque={bloques.nosotros} />
    <Caracteristicas bloque={bloques.caracteristicas} />
    {reviews.length > 0 && <Comentarios reviews={reviews} />}
    <ContactSection bloque={bloques.contacto} />

    {!hasAnyContent && (
      <section class="container-cimak py-24 text-center text-cimak-black/70">
        <p class="text-lg font-semibold">Sitio en configuración</p>
        <p class="mt-2 text-sm">
          Publica bloques, familias y testimonios desde el CRM (Página Web / Productos).
        </p>
      </section>
    )}
  </main>
</Layout>
