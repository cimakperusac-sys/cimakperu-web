---
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import logoBlanco from '../../assets/nosotros/logo-blanco.svg';
import fondoFooter from '../../assets/aluzinc/seccion/footer/fondo.svg';
---

<footer class="w-full text-white">
  <!--
    El perfil de cobertura sale del asset: se ancla arriba y el padding superior
    (2.345% del ancho por cada 100% de escala) deja ver solo esa franja.
  -->
  <div
    class="w-full bg-[length:200%_auto] bg-top bg-no-repeat pt-[4.7%] lg:bg-[length:100%_auto] lg:pt-[2.35%]"
    style={`background-image: url(${fondoFooter.src})`}
  >
    <div class="bg-black">
      <div class="container-cimak flex flex-col items-center gap-3 py-6 text-center sm:py-8">
        <Image
          src={logoBlanco}
          alt="CIMAK Coberturas"
          class="h-8 w-auto sm:h-9 lg:h-10"
          width={130}
          height={50}
          loading="lazy"
          decoding="async"
        />

        <!-- En escritorio estos datos ya están en la sección de contacto -->
        <div class="text-[0.7rem] leading-relaxed text-white/85 lg:hidden">
          <p class="font-bold text-white">Ubicación y Contacto</p>
          <p class="mt-1">
            <a href={site.phoneHref} class="hover:underline">{site.phone}</a>
          </p>
          <p>
            <a href={`mailto:${site.email}`} class="hover:underline">{site.email}</a>
          </p>
          <p class="mx-auto max-w-[16rem]">{site.address}</p>
        </div>

        <p class="max-w-[22rem] text-[0.65rem] leading-relaxed text-white/70 sm:max-w-none sm:text-[0.7rem]">
          © {new Date().getFullYear()} {site.legalName} RUC: {site.ruc} | Todos los derechos
          reservados
        </p>
      </div>
    </div>
  </div>
</footer>
