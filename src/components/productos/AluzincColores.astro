---
import { Image } from 'astro:assets';
import coloresImg from '../../assets/aluzinc/seccion/colores/colores.svg';

const colores = [
  { ral: 'RAL 3002', nombre: 'Rojo', hex: '#9B1B14' },
  { ral: 'RAL 3020', nombre: 'Rojo', hex: '#CC2A17' },
  { ral: 'RAL 3002', nombre: 'Rojo', hex: '#9E1B10' },
  { ral: 'RAL 6003', nombre: 'Verde', hex: '#4B4F3E' },
  { ral: 'RAL 6002', nombre: 'Verde', hex: '#1F5B33' },
  { ral: 'RAL 5002', nombre: 'Azul', hex: '#22306E' },
  { ral: 'RAL 5015', nombre: 'Azul', hex: '#0B7CC4' },
  { ral: 'RAL 7004', nombre: 'Gris', hex: '#9DA0A3' },
  { ral: 'RAL 2008', nombre: 'Anaranjado', hex: '#EE7B22' },
  { ral: 'RAL 2008', nombre: 'Blanco', hex: '#ECEDE7' },
];
---

<section
  id="colores"
  class="reveal-on-scroll w-full bg-white py-9 sm:py-12 lg:pb-16"
  aria-label="Colores disponibles"
>
  <div class="container-cimak">
    <div class="flex justify-center">
      <h2 class="rounded-full bg-cimak-black px-10 py-3 text-center text-[13px] font-bold uppercase tracking-wide text-white sm:px-16 lg:px-[87px] lg:py-3.5">
        Colores
      </h2>
    </div>

    <div class="mt-10 grid gap-8 lg:mt-20 lg:grid-cols-[minmax(0,0.93fr)_minmax(0,1fr)] lg:gap-16">
      <div>
        <p class="text-justify text-[13px] leading-[1.62] text-cimak-black/90">
          Nuestra línea de colores RAL ofrece la combinación perfecta entre estética y
          durabilidad para tus coberturas. Acabados de alta resistencia a la intemperie que
          mantienen su color vivo año tras año. Además de nuestra gama estándar, creamos
          colores personalizados para que tu diseño arquitectónico sea exactamente como lo
          imaginaste.
        </p>

        <ul class="mt-8 grid grid-cols-5 gap-x-1.5 gap-y-2.5 sm:gap-x-2.5 sm:gap-y-3.5 lg:max-w-[540px]">
          {
            colores.map((color) => (
              <li class="overflow-hidden rounded-[4px] bg-white shadow-[0_1px_6px_rgba(0,0,0,0.12)]">
                <span
                  class="block h-14 w-full sm:h-[84px] lg:h-24"
                  style={`background-color:${color.hex}`}
                  aria-hidden="true"
                ></span>
                <span class="block px-1.5 py-1.5 sm:px-2.5 sm:py-2.5">
                  <span class="block text-[9px] font-bold leading-tight text-cimak-black sm:text-[11px]">
                    {color.ral}
                  </span>
                  <span class="mt-0.5 block text-[8px] leading-tight text-cimak-black/60 sm:text-[10px]">
                    {color.nombre}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex items-stretch gap-1.5 lg:gap-2.5">
        <div class="aspect-[2/1] min-w-0 flex-1 overflow-hidden sm:aspect-[692/448] lg:aspect-auto">
          <Image
            src={coloresImg}
            alt="Cobertura de aluzinc en color rojo instalada en estructura metálica"
            class="h-full w-full object-cover"
            width={692}
            height={448}
            loading="lazy"
            decoding="async"
          />
        </div>

        <ul
          class="flex w-3.5 shrink-0 flex-col justify-between sm:w-6 lg:w-8"
          aria-hidden="true"
        >
          {
            colores.map((color) => (
              <li
                class="h-3.5 w-3.5 rounded-[2px] sm:h-6 sm:w-6 sm:rounded-[3px] lg:h-8 lg:w-8"
                style={`background-color:${color.hex}`}
              ></li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
