---
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import logo from '../../assets/footer/logo.svg';
import videoFondo from '../../assets/fondo/video-fondo-2.mp4';

interface Props {
  /** Foto de fondo (planta). Si no se pasa, se usa el video de planta en B/N. */
  bgImage?: any;
  /** Degradado blanco que va encima del fondo. */
  overlayImage?: any;
  /** Lámina de Aluzinc. */
  productImage?: any;
}

const { bgImage, overlayImage, productImage } = Astro.props as Props;

const navLinks = [
  { label: 'PRODUCTO', href: '#producto', active: true },
  { label: 'ESPECIFICACIONES', href: '#especificaciones', active: false },
  { label: 'COLORES', href: '#colores', active: false },
  { label: 'CONTACTO', href: '#contacto', active: false },
];

const whatsappHref = `https://wa.me/${site.whatsapp}`;
---

<section
  aria-label="Techos de Aluzinc"
  class="relative w-full overflow-hidden bg-white"
>
  <!-- Fondo -->
  <div class="absolute inset-0">
    {
      bgImage ? (
        <Image
          src={bgImage}
          alt=""
          class="h-full w-full object-cover grayscale"
          width={1600}
          height={900}
          loading="eager"
          decoding="async"
        />
      ) : (
        <video
          class="h-full w-full object-cover grayscale"
          src={videoFondo}
          autoplay
          muted
          loop
          playsinline
        ></video>
      )
    }
  </div>

  <!-- Degradado blanco encima del fondo -->
  {
    overlayImage ? (
      <Image
        src={overlayImage}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
        width={1200}
        height={743}
        loading="eager"
        decoding="async"
        aria-hidden="true"
      />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-white via-white/85 to-white/40" />
    )
  }

  <!-- Navbar propio -->
  <nav class="relative z-20 w-full">
    <div class="container-cimak flex items-center gap-4 py-3.5 sm:py-5">
      <a href="/" class="shrink-0">
        <Image
          src={logo}
          alt="CIMAK Coberturas"
          width={160}
          height={62}
          class="h-8 w-auto sm:h-9 lg:h-11"
          loading="eager"
          decoding="async"
        />
      </a>

      <ul class="mx-auto hidden items-center gap-5 text-[0.68rem] font-semibold tracking-wide text-cimak-black lg:flex xl:gap-10 xl:text-xs">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'transition',
                  link.active
                    ? 'rounded-full bg-cimak-yellow px-6 py-2.5 text-cimak-black'
                    : 'hover:opacity-60',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-auto inline-flex shrink-0 items-center gap-2 rounded-full bg-cimak-whatsapp px-3.5 py-2 text-[0.7rem] font-semibold text-white transition hover:opacity-90 sm:px-5 sm:py-2.5 sm:text-xs lg:ml-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="sm:h-[18px] sm:w-[18px]">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.37 5.07L2 22l5.1-1.34A9.96 9.96 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm5.47 12.3c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.48.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35z" />
        </svg>
        <span>Whatsapp</span>
      </a>
    </div>

    <!-- Menú en pantallas pequeñas -->
    <div class="container-cimak lg:hidden">
      <ul class="no-scrollbar flex items-center gap-2 overflow-x-auto pb-3 text-[0.62rem] font-semibold tracking-wide text-cimak-black sm:gap-3 sm:text-[0.7rem]">
        {
          navLinks.map((link) => (
            <li class="shrink-0">
              <a
                href={link.href}
                class:list={[
                  'block rounded-full px-4 py-1.5 transition',
                  link.active
                    ? 'bg-cimak-yellow text-cimak-black'
                    : 'bg-white/70 text-cimak-black/80',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- Contenido -->
  <div class="relative z-10 container-cimak">
    <div class="grid items-center gap-6 pb-10 pt-6 sm:pb-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] md:gap-4 md:pb-16 md:pt-10 lg:pb-20 lg:pt-14">
      <div>
        <h1 class="text-[2.1rem] font-extrabold uppercase leading-[0.95] tracking-tight text-cimak-black min-[420px]:text-[2.6rem] sm:text-5xl md:text-[3.4rem] lg:text-[4.5rem] xl:text-[5.5rem]">
          Techos de<br />Aluzinc
        </h1>
        <p class="mt-2.5 text-sm font-medium uppercase tracking-[0.3em] text-cimak-black min-[420px]:text-base sm:text-lg sm:tracking-[0.35em] lg:mt-4 lg:text-2xl">
          Modelos TR4 / TR5
        </p>

        <a
          href="#contacto"
          class="mt-6 inline-flex items-center justify-center rounded-lg bg-cimak-yellow px-7 py-3.5 text-xs font-extrabold uppercase tracking-wide text-cimak-black transition hover:opacity-90 sm:px-9 sm:py-4 sm:text-sm lg:mt-9 lg:text-base"
        >
          Cotiza ahora
        </a>
      </div>

      <div class="flex justify-center md:justify-end">
        {
          productImage ? (
            <Image
              src={productImage}
              alt="Cobertura de Aluzinc TR4 / TR5"
              class="h-auto w-full max-w-[420px] object-contain drop-shadow-2xl sm:max-w-[520px] md:max-w-none md:translate-x-4 lg:translate-x-10"
              width={607}
              height={566}
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="flex aspect-[607/566] w-full max-w-[520px] items-center justify-center rounded-xl border border-dashed border-black/25 bg-white/40">
              <span class="text-sm font-semibold text-cimak-black/60">
                IMAGEN DEL PRODUCTO
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <div id="producto" class="h-0 w-0" aria-hidden="true"></div>
</section>
