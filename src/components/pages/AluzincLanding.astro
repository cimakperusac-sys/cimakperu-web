---
import Layout from '../../layouts/Layout.astro';
import AluzincHero from '../productos/AluzincHero.astro';
import AluzincEspecificaciones from '../productos/AluzincEspecificaciones.astro';
import AluzincColores from '../productos/AluzincColores.astro';
import AluzincContacto from '../productos/AluzincContacto.astro';
import AluzincFooter from '../productos/AluzincFooter.astro';
import { cotizarHref, resolverMensajePagina } from '../../lib/catalogo';
import { site } from '../../data/site';

import heroFondo from '../../assets/aluzinc/seccion/hero/hero-fondo-dos.svg';
import productAluzinc from '../../assets/aluzinc/seccion/hero/aluzinc.svg';

const mensaje = await resolverMensajePagina('aluzinc');
const siteUrl = (Astro.site?.href || site.url).replace(/\/$/, '');
const whatsappHref = cotizarHref({
  mensaje,
  url: new URL('/general/aluzinc', `${siteUrl}/`).href,
  origenTipo: 'pagina',
  origenClave: 'aluzinc',
});
---

<Layout
  title="Techos de Aluzinc TR4 / TR5 | CIMAK Perú"
  description="Techos de Aluzinc modelos TR4 y TR5 fabricados en Perú. Alta resistencia a la corrosión, reflectividad térmica y colores RAL. Cotiza con CIMAK Perú sin intermediarios."
  image="/og-aluzinc.svg"
  imageAlt="Láminas de Aluzinc TR4 / TR5 de CIMAK Perú"
  keywords="techos de aluzinc, aluzinc Perú, cobertura aluzinc, TR4, TR5, CIMAK, coberturas metálicas Lima"
  canonical="/general/aluzinc"
  type="product"
  showHeader={false}
  showFooter={false}
  showWhatsApp={true}
  mensajeWhatsapp={mensaje}
  origenTipo="pagina"
  origenClave="aluzinc"
>
  <main>
    <AluzincHero bgImage={heroFondo} productImage={productAluzinc} whatsappHref={whatsappHref} />
    <AluzincEspecificaciones />
    <AluzincColores />
    <AluzincContacto />
  </main>
  <AluzincFooter />
</Layout>
