---
import { familiaHref, productoHref } from '../../lib/catalogo';
import type { WebMenuFamilia } from '../../lib/types/web';

interface Props {
  menu?: WebMenuFamilia[];
  familiaActiva?: string | null;
  productoActivo?: string | null;
}

const { menu = [], familiaActiva = null, productoActivo = null } = Astro.props;
if (menu.length === 0) {
  return null;
}
---

<aside class="lg:sticky lg:top-28" aria-label="Categorías del catálogo">
  <h2 class="mb-3 hidden text-base font-extrabold uppercase tracking-wide text-cimak-black lg:block">
    Categorías
  </h2>

  <button
    type="button"
    id="catalogo-toggle"
    class="flex min-h-12 w-full items-center justify-between gap-3 rounded-lg border border-black/10 bg-white px-4 text-sm font-extrabold uppercase tracking-wide text-cimak-black lg:hidden"
    aria-expanded="false"
    aria-controls="catalogo-panel"
  >
    <span>Categorías</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      class="h-4 w-4 shrink-0 transition-transform"
      data-catalogo-chevron
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </button>

  <div
    id="catalogo-panel"
    class="mt-2 hidden max-h-[70svh] overflow-y-auto overscroll-contain rounded-lg border border-black/10 bg-white p-4 lg:mt-0 lg:block lg:max-h-[calc(100svh-9rem)]"
    data-lenis-prevent
  >
    <p class="text-[0.7rem] font-bold uppercase tracking-[0.14em] text-cimak-black/45">Productos</p>

    <ul class="mt-2 divide-y divide-black/10">
      {menu.map((familia) => {
        const activa = Boolean(familiaActiva && familia.slug === familiaActiva);
        const href = familiaHref(familia);

        return (
          <li>
            {familia.subcategorias.length > 0 ? (
              <details class="group" open={activa}>
                <summary
                  class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 py-2 text-sm font-extrabold uppercase tracking-wide text-cimak-black"
                  aria-current={activa ? 'page' : undefined}
                >
                  <span>{familia.nombre}</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>

                <div class="pb-3">
                  <a
                    href={href}
                    class="inline-flex min-h-9 items-center text-xs font-semibold text-cimak-black/70 hover:text-cimak-black"
                  >
                    Ver toda la familia
                  </a>

                  {familia.subcategorias.map((sub) => (
                    <div class="mt-1">
                      <p class="text-xs font-semibold text-cimak-black/80">{sub.nombre}</p>
                      <ul class="mt-1 list-disc pl-5 marker:text-cimak-black/30">
                        {sub.productos.map((producto) => {
                          const url = productoHref(producto);
                          const activo = Boolean(productoActivo && producto.slug === productoActivo);

                          return url ? (
                            <li>
                              <a
                                href={url}
                                aria-current={activo ? 'page' : undefined}
                                class:list={[
                                  'block py-1.5 text-xs transition hover:text-cimak-black lg:py-1',
                                  activo
                                    ? 'font-bold text-cimak-black'
                                    : 'text-cimak-black/65',
                                ]}
                              >
                                {producto.nombre}
                              </a>
                            </li>
                          ) : null;
                        })}
                      </ul>
                    </div>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={href}
                aria-current={activa ? 'page' : undefined}
                class:list={[
                  'flex min-h-12 items-center py-2 text-sm font-extrabold uppercase tracking-wide',
                  activa ? 'text-cimak-black' : 'text-cimak-black/75 hover:text-cimak-black',
                ]}
              >
                {familia.nombre}
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</aside>

<noscript>
  <style>
    #catalogo-panel {
      display: block;
    }
  </style>
</noscript>

<script>
  const toggle = document.getElementById('catalogo-toggle');
  const panel = document.getElementById('catalogo-panel');

  if (toggle && panel) {
    const chevron = toggle.querySelector('[data-catalogo-chevron]');

    toggle.addEventListener('click', () => {
      const abierto = panel.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(abierto));
      chevron?.classList.toggle('rotate-180', abierto);
    });
  }
</script>

<style>
  #catalogo-panel details > summary::-webkit-details-marker {
    display: none;
  }
</style>
