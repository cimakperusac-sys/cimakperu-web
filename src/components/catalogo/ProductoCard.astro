---
import type { WebProductoCard } from '../../lib/types/web';
import { cotizarHref, productoHref } from '../../lib/catalogo';

interface Props {
  producto: WebProductoCard;
  variant?: 'grid' | 'carousel';
  showCotizar?: boolean;
  eager?: boolean;
}

const { producto, variant = 'grid', showCotizar = false, eager = false } = Astro.props;

const href = productoHref(producto);
const enOferta = Number(producto.oferta) === 1;
const ofertaTexto = (producto.oferta_texto || 'Oferta del día').toUpperCase();

const anchoCarrusel = 'w-[44vw] max-w-[220px] min-w-[140px] shrink-0 snap-start sm:w-[210px]';
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-lg border border-black/10 bg-white transition hover:border-black/20 hover:shadow-md',
    variant === 'carousel' && anchoCarrusel,
  ]}
>
  <div class="relative aspect-square w-full overflow-hidden bg-neutral-100">
    {producto.url ? (
      <img
        src={producto.url}
        alt={producto.nombre}
        class="h-full w-full object-contain p-4 transition duration-500 group-hover:scale-105 sm:p-5"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="flex h-full items-center justify-center px-3 text-center text-[11px] font-semibold uppercase tracking-wide text-cimak-black/35">
        Sin imagen
      </div>
    )}

    {enOferta && (
      <span class="absolute left-2 top-2 rounded-sm bg-cimak-black px-2 py-1 text-[9px] font-bold uppercase leading-none tracking-wide text-white">
        {ofertaTexto}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col gap-2 px-3 py-2.5">
    <h3 class="text-[0.78rem] font-semibold leading-snug text-cimak-black sm:text-sm">
      {href ? (
        <a
          href={href}
          class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cimak-yellow"
        >
          {producto.nombre}
        </a>
      ) : (
        producto.nombre
      )}
    </h3>

    {showCotizar && (
      <a
        href={cotizarHref(producto.nombre)}
        target="_blank"
        rel="noopener noreferrer"
        class="relative z-10 mt-auto inline-flex min-h-9 w-fit items-center rounded-sm bg-cimak-yellow px-4 text-xs font-bold text-cimak-black transition hover:brightness-105"
      >
        Cotizar
      </a>
    )}
  </div>
</article>
