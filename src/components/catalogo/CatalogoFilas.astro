---
import ProductoCard from './ProductoCard.astro';
import type { WebProductoCard } from '../../lib/types/web';

interface Seccion {
  nombre: string;
  productos: WebProductoCard[];
}

interface Props {
  secciones: Seccion[];
  familiaNombre?: string;
}

const { secciones } = Astro.props;
---

{secciones.map((seccion) => (
  <section class="reveal-on-scroll min-w-0" aria-label={seccion.nombre}>
    <h2 class="mb-3 text-sm font-bold text-cimak-black sm:mb-4 sm:text-base">
      {seccion.nombre}
    </h2>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-2 sm:gap-4 md:grid-cols-3 lg:gap-5">
      {seccion.productos.map((producto, index) => (
        <ProductoCard producto={producto} eager={index < 6} />
      ))}
    </div>
  </section>
))}
