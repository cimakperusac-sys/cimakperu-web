---
interface Props {
  totalProductos?: number;
  totalFamilias?: number;
}

const { totalProductos = 0, totalFamilias = 0 } = Astro.props;

const resumen =
  totalProductos > 0
    ? `${totalProductos} producto${totalProductos === 1 ? '' : 's'} en ${totalFamilias} familia${totalFamilias === 1 ? '' : 's'}`
    : 'Explora nuestras familias de coberturas';
---

<div class="catalogo-busqueda">
  <label class="sr-only" for="catalogo-busqueda-input">Buscar en el catálogo</label>
  <div class="relative">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-cimak-black/40"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-3.5-3.5" />
    </svg>
    <input
      id="catalogo-busqueda-input"
      type="search"
      name="q"
      placeholder="Buscar productos o familias…"
      autocomplete="off"
      class="w-full rounded-lg border border-black/10 bg-white py-3 pl-10 pr-10 text-sm text-cimak-black outline-none placeholder:text-cimak-black/40 focus:border-cimak-black/25 sm:text-base"
    />
    <button
      type="button"
      id="catalogo-busqueda-clear"
      class="absolute right-2 top-1/2 hidden -translate-y-1/2 rounded-md p-1.5 text-cimak-black/45 transition hover:bg-black/5 hover:text-cimak-black"
      aria-label="Limpiar búsqueda"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
  <p class="mt-2 text-xs text-cimak-black/55">{resumen}</p>
  <p id="catalogo-busqueda-vacio" class="mt-4 hidden rounded-lg border border-dashed border-black/15 bg-white px-4 py-8 text-center text-sm text-cimak-black/65">
    No encontramos productos con ese criterio. Prueba con otro nombre o familia.
  </p>
</div>

<script>
  const input = document.getElementById('catalogo-busqueda-input');
  const clearBtn = document.getElementById('catalogo-busqueda-clear');
  const emptyMsg = document.getElementById('catalogo-busqueda-vacio');
  const familias = [...document.querySelectorAll('[data-catalogo-familia]')];

  if (input && familias.length) {
    const normalize = (value) =>
      String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();

    const filter = () => {
      const q = normalize(input.value);
      clearBtn?.classList.toggle('hidden', !q);
      let visibles = 0;

      familias.forEach((familia) => {
        const items = [...familia.querySelectorAll('[data-catalogo-item]')];
        let familiaVisible = false;

        if (!q) {
          items.forEach((item) => item.classList.remove('hidden'));
          familia.classList.remove('hidden');
          visibles += items.length;
          return;
        }

        const familiaTexto = normalize(familia.getAttribute('data-search') || '');
        const coincideFamilia = familiaTexto.includes(q);

        items.forEach((item) => {
          const itemTexto = normalize(item.getAttribute('data-search') || '');
          const visible = coincideFamilia || itemTexto.includes(q);
          item.classList.toggle('hidden', !visible);
          if (visible) familiaVisible = true;
        });

        familia.classList.toggle('hidden', !familiaVisible);
        if (familiaVisible) visibles += items.filter((item) => !item.classList.contains('hidden')).length;
      });

      emptyMsg?.classList.toggle('hidden', visibles > 0 || !q);
    };

    input.addEventListener('input', filter);
    clearBtn?.addEventListener('click', () => {
      input.value = '';
      filter();
      input.focus();
    });

    const params = new URLSearchParams(window.location.search);
    const qParam = params.get('q');
    if (qParam) {
      input.value = qParam;
      filter();
    }
  }
</script>
