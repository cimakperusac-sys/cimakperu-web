---
import type { WebBloque } from '../../lib/types/web';
import { cmsHtml, cmsPlain, cmsTitleHtml } from '../../lib/cmsHtml';

interface Props {
  bloque?: WebBloque | null;
}

const { bloque } = Astro.props;
if (!bloque || (!bloque.titulo && !bloque.contenido && !bloque.url)) {
  return null;
}

const titleHtml = cmsTitleHtml(bloque.titulo) || cmsTitleHtml('Blog');
const bodyHtml = cmsHtml(bloque.contenido || bloque.subtitulo);
const href = bloque.cta_url || '/blog';
const cta = bloque.cta_texto || 'Ver más';
const bg = bloque.url || null;
const aria = cmsPlain(bloque.titulo) || 'Blog';
---

<section
  id="blog-banner"
  class="reveal-on-scroll relative w-full overflow-hidden min-h-[220px] sm:min-h-[280px]"
  aria-label={aria}
>
  {bg ? (
    <img
      src={bg}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class="absolute inset-0 bg-cimak-black" aria-hidden="true"></div>
  )}
  <div class="absolute inset-0 bg-black/55"></div>

  <div class="container-cimak relative z-10 flex flex-col items-start gap-4 py-12 text-white sm:py-16">
    <div class="cms-prose cms-prose--title max-w-md text-[1.35rem] font-semibold leading-snug sm:text-[1.65rem]" set:html={titleHtml} />
    {bodyHtml && <div class="cms-prose max-w-lg text-sm text-white/90 sm:text-base" set:html={bodyHtml} />}
    <a
      href={href}
      class="inline-block rounded-md bg-[#ffba2e] px-5 py-2 text-sm font-bold text-cimak-black transition hover:brightness-105"
    >
      {cta}
    </a>
  </div>
</section>
