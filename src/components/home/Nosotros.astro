---
import type { WebBloque } from '../../lib/types/web';
import { cmsHtml, cmsPlain, cmsTitleHtml } from '../../lib/cmsHtml';

interface Props {
  bloque?: WebBloque | null;
}

const { bloque } = Astro.props;
if (!bloque || (!bloque.titulo && !bloque.contenido && !bloque.url)) {
  return null;
}

const titleHtml = cmsTitleHtml(bloque.titulo) || cmsTitleHtml('¿Quiénes somos?');
const bodyHtml = cmsHtml(bloque.contenido || bloque.subtitulo);
const img = bloque.url || null;
const aria = cmsPlain(bloque.titulo) || 'Quiénes somos';
---

<section id="nosotros" class="reveal-on-scroll w-full bg-[#f3f3f3] py-8 sm:py-14" aria-label={aria}>
  <div class="container-cimak">
    <div class="mb-5 flex justify-center md:hidden">
      <div class="rounded-md bg-cimak-yellow px-6 py-2 text-center text-sm font-bold text-cimak-black">
        <div class="cms-prose cms-prose--title" set:html={titleHtml} />
      </div>
    </div>

    <div class="mb-8 hidden text-center text-2xl font-extrabold text-cimak-black md:block lg:text-[1.75rem]">
      <div class="cms-prose cms-prose--title" set:html={titleHtml} />
    </div>

    <div class="rounded-xl border border-cimak-black bg-white px-5 py-7 md:hidden">
      {bodyHtml && <div class="cms-prose text-center text-sm text-cimak-black" set:html={bodyHtml} />}
      {img && (
        <img src={img} alt={aria} class="mt-5 h-auto w-full rounded-lg object-cover" loading="lazy" decoding="async" />
      )}
    </div>

    <div class="hidden items-stretch gap-8 md:grid md:grid-cols-2 lg:gap-10">
      {img ? (
        <div class="overflow-hidden rounded-2xl">
          <img src={img} alt={aria} class="h-full w-full object-cover object-top" loading="lazy" decoding="async" />
        </div>
      ) : (
        <div class="rounded-2xl bg-cimak-black/5"></div>
      )}
      <div class="flex flex-col items-center justify-center px-2">
        {bodyHtml && <div class="cms-prose text-center text-base text-cimak-black" set:html={bodyHtml} />}
        {bloque.cta_texto && bloque.cta_url && (
          <a
            href={bloque.cta_url}
            class="mt-6 inline-block rounded-md bg-cimak-yellow px-5 py-2 text-sm font-bold text-cimak-black"
          >
            {bloque.cta_texto}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
