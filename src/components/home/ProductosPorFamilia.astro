---
import ProductoCard from '../catalogo/ProductoCard.astro';
import { familiaHref } from '../../lib/catalogo';
import type { WebFamilia } from '../../lib/types/web';

interface Props {
  familias?: WebFamilia[];
}

const { familias = [] } = Astro.props;

const conProductos = familias.filter((f) => (f.productos?.length ?? 0) > 0);
if (conProductos.length === 0) {
  return null;
}
---

<section id="productos" class="w-full bg-[#f3f3f3] pb-10 md:pb-14" aria-label="Productos por categoría">
  <div class="container-cimak">
    <div class="reveal-stagger flex flex-col gap-8 sm:gap-10" data-reveal-gap="120">
      {conProductos.map((familia) => {
        const href = familiaHref(familia);
        const productos = familia.productos ?? [];

        return (
          <div class="reveal-on-scroll reveal-up reveal-item">
            <div class="flex items-end justify-between gap-3">
              <h3 class="text-sm font-extrabold uppercase tracking-[0.08em] text-cimak-black sm:text-base">
                <a href={href} class="hover:text-cimak-black/60">{familia.nombre}</a>
              </h3>

              <a
                href={href}
                class="hidden shrink-0 items-center gap-1 text-xs font-bold uppercase tracking-wide text-cimak-black/70 transition hover:text-cimak-black md:inline-flex"
              >
                Ver todos
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </div>

            <div class="no-scrollbar -mx-4 mt-3 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-1 md:hidden">
              {productos.map((producto) => (
                <ProductoCard producto={producto} variant="carousel" />
              ))}
            </div>

            <div class="mt-4 hidden gap-4 md:grid md:grid-cols-3 lg:grid-cols-6">
              {productos.slice(0, 6).map((producto) => (
                <ProductoCard producto={producto} />
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
