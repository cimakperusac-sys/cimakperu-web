---
import { Image } from 'astro:assets';
import logoEstrellas from '../../assets/comentarios/logo-estrellas.svg';

type Review = {
  name: string;
  initial: string;
  color: string;
  text: string;
};

interface Props {
  reviews?: Review[];
}

const { reviews: propReviews } = Astro.props;
const reviews = propReviews ?? [];

if (!reviews.length) {
  return null;
}
---

<section
  id="comentarios"
  class="w-full overflow-hidden bg-[#f3f3f3] py-10 sm:py-16"
  aria-label="Opiniones de clientes"
>
  <div class="reveal-on-scroll reveal-zoom container-cimak flex flex-col items-center">
    <Image
      src={logoEstrellas}
      alt="CIMAK 4.8 estrellas"
      class="h-auto w-[160px] sm:w-[177px]"
      width={177}
      height={81}
      loading="lazy"
      decoding="async"
    />
    <p class="mt-3 text-center text-sm font-medium text-cimak-black sm:text-base">
      Basado en Opiniones y Recomendaciones
    </p>
  </div>

  <div class="reveal-on-scroll reveal-up reveal-delay-2 relative mt-7 w-full overflow-hidden sm:mt-10" id="reviews-viewport">
    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-[#f3f3f3] via-[#f3f3f3]/80 to-transparent sm:w-24 lg:w-32"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-[#f3f3f3] via-[#f3f3f3]/80 to-transparent sm:w-24 lg:w-32"
      aria-hidden="true"
    ></div>

    <div id="reviews-track" class="flex w-max gap-3 will-change-transform sm:gap-4">
      {[...reviews, ...reviews].map((review) => (
        <article class="w-[220px] shrink-0 rounded-xl border border-black/10 bg-white p-4 shadow-sm sm:w-[270px] sm:p-5">
          <div class="flex items-start justify-between gap-2">
            <div class="flex min-w-0 items-center gap-2.5">
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white sm:h-10 sm:w-10"
                style={`background-color: ${review.color}`}
              >
                {review.initial}
              </span>
              <div class="min-w-0">
                <p class="truncate text-sm font-bold uppercase tracking-wide text-cimak-black">
                  {review.name}
                </p>
                <div class="mt-0.5 flex gap-0.5" aria-label="5 estrellas">
                  {Array.from({ length: 5 }).map(() => (
                    <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        fill="#FFBA2E"
                        d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.47L12 17.77l-5.8 3.05 1.11-6.47-4.7-4.58 6.49-.94L12 2.5z"
                      />
                    </svg>
                  ))}
                </div>
              </div>
            </div>

            <span class="shrink-0" aria-label="Google" title="Google">
              <svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true">
                <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l5.7-5.7C34.2 6.1 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.9z"/>
                <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.1 8 3l5.7-5.7C34.2 6.1 29.4 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
                <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.3 35.3 26.8 36 24 36c-5.3 0-9.7-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
                <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4.1 5.5l.1.1 6.2 5.2C39.2 37.3 44 32 44 24c0-1.3-.1-2.7-.4-3.9z"/>
              </svg>
            </span>
          </div>

          {review.text && (
            <div class="cms-prose mt-3 text-sm leading-snug text-cimak-black/85" set:html={review.text} />
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const viewport = document.getElementById('reviews-viewport');
  const track = document.getElementById('reviews-track');

  if (viewport && track) {
    let x = 0;
    let paused = false;
    const speed = 0.55;

    const tick = () => {
      if (!paused) {
        x -= speed;
        const loopWidth = track.scrollWidth / 2;
        if (-x >= loopWidth) x += loopWidth;
        track.style.transform = `translate3d(${x}px, 0, 0)`;
      }
      requestAnimationFrame(tick);
    };

    viewport.addEventListener('mouseenter', () => {
      paused = true;
    });
    viewport.addEventListener('mouseleave', () => {
      paused = false;
    });
    viewport.addEventListener(
      'touchstart',
      () => {
        paused = true;
      },
      { passive: true }
    );
    viewport.addEventListener(
      'touchend',
      () => {
        paused = false;
      },
      { passive: true }
    );

    requestAnimationFrame(tick);
  }
</script>
