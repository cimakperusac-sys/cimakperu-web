---
import type { WebBloque } from '../../lib/types/web';
import { cmsHtml, cmsPlain, cmsTitleHtml } from '../../lib/cmsHtml';

interface Props {
  bloque?: WebBloque | null;
}

type Slide = { url: string; href?: string; alt?: string };

const { bloque } = Astro.props;
if (!bloque) {
  return null;
}

const extra = (bloque.extra && typeof bloque.extra === 'object' ? bloque.extra : {}) as Record<
  string,
  unknown
>;
const slidesFromExtra = Array.isArray(extra.slides) ? (extra.slides as Slide[]) : [];
const slides: Slide[] =
  slidesFromExtra.filter((s) => s?.url).length > 0
    ? slidesFromExtra.filter((s) => s?.url)
    : bloque.url
      ? [{ url: bloque.url, href: bloque.cta_url || '/catalogo', alt: cmsPlain(bloque.titulo) }]
      : [];

if (!slides.length && !bloque.titulo) {
  return null;
}

const catalogHref = bloque.cta_url || '/catalogo';
const titleHtml = cmsTitleHtml(bloque.titulo) || cmsTitleHtml('Catálogo de productos');
const subHtml = cmsHtml(bloque.subtitulo);
const catalogCta = bloque.cta_texto || 'Ver';
const catalogImg = typeof extra.catalogo_url === 'string' ? extra.catalogo_url : null;
const aria = cmsPlain(bloque.titulo) || 'Promociones';
---

<section id="promociones" class="reveal-on-scroll w-full" aria-label={aria}>
  <div class="relative grid grid-cols-1 items-stretch lg:grid-cols-2">
    <a
      href={catalogHref}
      class="group relative z-10 flex min-h-[180px] items-center overflow-hidden bg-cimak-yellow px-6 py-8 lg:min-h-full lg:px-8"
    >
      <div class="relative z-30 flex items-center gap-5">
        <div class="flex min-w-0 flex-col items-start gap-3">
          <div class="cms-prose cms-prose--title text-xl font-extrabold uppercase leading-tight tracking-tight text-cimak-black xl:text-2xl" set:html={titleHtml} />
          {subHtml && <div class="cms-prose text-sm text-cimak-black/80" set:html={subHtml} />}
          <span class="inline-block bg-cimak-black px-5 py-1.5 text-sm font-bold uppercase tracking-wider text-white">
            {catalogCta}
          </span>
        </div>
      </div>
      {catalogImg && (
        <img
          src={catalogImg}
          alt=""
          class="pointer-events-none absolute top-1/2 right-0 z-20 hidden w-[55%] max-w-[420px] translate-x-[30%] -translate-y-1/2 drop-shadow-xl lg:block"
          loading="lazy"
          decoding="async"
        />
      )}
    </a>

    {slides.length > 0 && (
      <div id="promo-carousel" class="relative z-0 overflow-hidden bg-[#2a6aa8]" data-slides={slides.length}>
        {slides.map((slide, index) => (
          <a
            href={slide.href || catalogHref}
            class:list={[
              'promo-slide block w-full transition-opacity duration-500',
              index === 0 ? 'relative z-10 opacity-100' : 'pointer-events-none absolute inset-0 z-0 opacity-0',
            ]}
            data-index={index}
            aria-hidden={index !== 0}
          >
            <img
              src={slide.url}
              alt={slide.alt || aria}
              class="block h-auto w-full object-cover"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
        ))}
      </div>
    )}
  </div>
</section>

{slides.length > 1 && (
  <script>
    const root = document.getElementById('promo-carousel');
    if (root) {
      const slides = [...root.querySelectorAll('.promo-slide')];
      let i = 0;
      setInterval(() => {
        slides[i]?.classList.remove('relative', 'z-10', 'opacity-100');
        slides[i]?.classList.add('pointer-events-none', 'absolute', 'inset-0', 'z-0', 'opacity-0');
        slides[i]?.setAttribute('aria-hidden', 'true');
        i = (i + 1) % slides.length;
        slides[i]?.classList.add('relative', 'z-10', 'opacity-100');
        slides[i]?.classList.remove('pointer-events-none', 'absolute', 'inset-0', 'z-0', 'opacity-0');
        slides[i]?.setAttribute('aria-hidden', 'false');
      }, 4500);
    }
  </script>
)}
