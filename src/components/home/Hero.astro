---
import type { WebBloque, WebTipoMedia } from '../../lib/types/web';
import { cmsHtml, cmsPlain, cmsTitleHtml } from '../../lib/cmsHtml';

interface Props {
  bloque?: WebBloque | null;
}

const { bloque } = Astro.props;
if (!bloque?.url) {
  return null;
}

function esVideo(url: string, tipo?: WebTipoMedia | null, mime?: string | null): boolean {
  if (tipo === 'video') return true;
  if (tipo === 'image') return false;
  if (mime?.startsWith('video/')) return true;
  if (mime?.startsWith('image/')) return false;
  return /\.(mp4|webm|ogg|ogv|mov|m4v)(\?|$)/i.test(url);
}

const desktop = {
  src: bloque.url,
  video: esVideo(bloque.url, bloque.tipo_media, bloque.mime_type),
};

const mobile = bloque.url_mobile
  ? {
      src: bloque.url_mobile,
      video: esVideo(bloque.url_mobile, bloque.tipo_media_mobile, bloque.mime_type_mobile),
    }
  : null;

/** Dos imágenes se resuelven con <picture>: una sola descarga y cero JS. */
const soloImagenes = Boolean(mobile) && !desktop.video && !mobile!.video;

const nextHref = '#promociones';
const titleHtml = cmsTitleHtml(bloque.titulo);
const bodyHtml = cmsHtml(bloque.contenido || bloque.subtitulo);
const aria = cmsPlain(bloque.titulo) || 'Hero';

const mediaClass = 'h-full w-full object-cover md:h-auto';
---

<section
  id="hero"
  class="relative flex min-h-[70svh] w-full overflow-hidden bg-cimak-black md:min-h-0"
  aria-label={aria}
>
  <div class="absolute inset-0 md:relative md:inset-auto md:w-full">
    {soloImagenes ? (
      <picture class="block h-full">
        <source media="(min-width: 768px)" srcset={desktop.src} />
        <img
          src={mobile!.src}
          alt={aria}
          class={`block ${mediaClass}`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    ) : mobile ? (
      <div class="h-full" data-hero-media>
        <div class="h-full md:hidden">
          {mobile.video ? (
            <video
              class={`block ${mediaClass}`}
              data-hero-src={mobile.src}
              data-hero-when="mobile"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label={aria}
            ></video>
          ) : (
            <img
              class={`block ${mediaClass}`}
              data-hero-src={mobile.src}
              data-hero-when="mobile"
              alt={aria}
              decoding="async"
            />
          )}
        </div>

        <div class="hidden h-full md:block">
          {desktop.video ? (
            <video
              class={`block ${mediaClass}`}
              data-hero-src={desktop.src}
              data-hero-when="desktop"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label={aria}
            ></video>
          ) : (
            <img
              class={`block ${mediaClass}`}
              data-hero-src={desktop.src}
              data-hero-when="desktop"
              alt={aria}
              decoding="async"
            />
          )}
        </div>

        <noscript>
          <div class="h-full md:hidden">
            {mobile.video ? (
              <video class={`block ${mediaClass}`} src={mobile.src} autoplay muted loop playsinline></video>
            ) : (
              <img class={`block ${mediaClass}`} src={mobile.src} alt={aria} />
            )}
          </div>
          <div class="hidden h-full md:block">
            {desktop.video ? (
              <video class={`block ${mediaClass}`} src={desktop.src} autoplay muted loop playsinline></video>
            ) : (
              <img class={`block ${mediaClass}`} src={desktop.src} alt={aria} />
            )}
          </div>
        </noscript>
      </div>
    ) : desktop.video ? (
      <video
        class={`block ${mediaClass}`}
        src={desktop.src}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={aria}
      ></video>
    ) : (
      <img
        class={`block ${mediaClass}`}
        src={desktop.src}
        alt={aria}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}
  </div>

  {(titleHtml || bodyHtml || bloque.cta_texto) && (
    <div class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-black/35 px-4 text-center text-white">
      {titleHtml && (
        <div
          class="cms-prose cms-prose--title text-2xl font-extrabold uppercase tracking-tight sm:text-4xl lg:text-[2.75rem]"
          set:html={titleHtml}
        />
      )}
      {bodyHtml && (
        <div class="cms-prose mt-3 max-w-xl text-sm sm:text-base text-white/90" set:html={bodyHtml} />
      )}
      {bloque.cta_texto && bloque.cta_url && (
        <a
          href={bloque.cta_url}
          class="mt-5 inline-flex min-h-11 items-center rounded-md bg-cimak-yellow px-5 py-2 text-sm font-bold text-cimak-black"
        >
          {bloque.cta_texto}
        </a>
      )}
    </div>
  )}

  <a
    href={nextHref}
    class="absolute bottom-4 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center gap-1.5 text-white no-underline sm:bottom-8 sm:gap-2"
    aria-label="Desplázate hacia abajo"
  >
    <span class="text-[10px] font-semibold uppercase tracking-[0.2em] opacity-90 sm:text-xs">
      Scroll
    </span>
    <span class="scroll-hint flex h-8 w-5 items-start justify-center rounded-full border-2 border-white/80 p-1 sm:h-10 sm:w-6 sm:p-1.5">
      <span class="scroll-hint-dot block h-1.5 w-1.5 rounded-full bg-white"></span>
    </span>
  </a>
</section>

<script>
  const root = document.querySelector('[data-hero-media]');

  if (root) {
    const media = [...root.querySelectorAll('[data-hero-src]')];
    const desktopQuery = window.matchMedia('(min-width: 768px)');

    const activar = () => {
      const objetivo = desktopQuery.matches ? 'desktop' : 'mobile';
      media.forEach((el) => {
        if (el.dataset.heroWhen !== objetivo || el.dataset.heroLoaded) return;
        el.src = el.dataset.heroSrc;
        el.dataset.heroLoaded = '1';
        if (el.tagName === 'VIDEO') el.play?.().catch(() => {});
      });
    };

    activar();
    desktopQuery.addEventListener('change', activar);
  }
</script>
