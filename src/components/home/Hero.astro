---
import type { WebBloque } from '../../lib/types/web';
import { cmsHtml, cmsPlain, cmsTitleHtml } from '../../lib/cmsHtml';

interface Props {
  bloque?: WebBloque | null;
}

const { bloque } = Astro.props;
if (!bloque?.url) {
  return null;
}

const src = bloque.url;
const isVideo = /\.(mp4|webm|ogg|mov)(\?|$)/i.test(src);
const nextHref = '#promociones';
const titleHtml = cmsTitleHtml(bloque.titulo);
const bodyHtml = cmsHtml(bloque.contenido || bloque.subtitulo);
const aria = cmsPlain(bloque.titulo) || 'Hero';
---

<section
  id="hero"
  class="relative w-full overflow-hidden bg-cimak-black"
  aria-label={aria}
>
  {isVideo ? (
    <video class="block h-auto w-full" src={src} autoplay muted loop playsinline></video>
  ) : (
    <img class="block h-auto w-full object-cover" src={src} alt={aria} />
  )}

  {(titleHtml || bodyHtml || bloque.cta_texto) && (
    <div class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-black/35 px-4 text-center text-white">
      {titleHtml && (
        <div
          class="cms-prose cms-prose--title text-2xl font-extrabold uppercase tracking-tight sm:text-4xl lg:text-[2.75rem]"
          set:html={titleHtml}
        />
      )}
      {bodyHtml && (
        <div class="cms-prose mt-3 max-w-xl text-sm sm:text-base text-white/90" set:html={bodyHtml} />
      )}
      {bloque.cta_texto && bloque.cta_url && (
        <a
          href={bloque.cta_url}
          class="mt-5 inline-block rounded-md bg-cimak-yellow px-5 py-2 text-sm font-bold text-cimak-black"
        >
          {bloque.cta_texto}
        </a>
      )}
    </div>
  )}

  <a
    href={nextHref}
    class="absolute bottom-4 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center gap-1.5 text-white no-underline sm:bottom-8 sm:gap-2"
    aria-label="Desplázate hacia abajo"
  >
    <span class="text-[10px] font-semibold uppercase tracking-[0.2em] opacity-90 sm:text-xs">
      Scroll
    </span>
    <span class="scroll-hint flex h-8 w-5 items-start justify-center rounded-full border-2 border-white/80 p-1 sm:h-10 sm:w-6 sm:p-1.5">
      <span class="scroll-hint-dot block h-1.5 w-1.5 rounded-full bg-white"></span>
    </span>
  </a>
</section>
