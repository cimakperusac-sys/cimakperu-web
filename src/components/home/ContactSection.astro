---
import type { WebBloque } from '../../lib/types/web';
import { cmsHtml, cmsPlain, cmsTitleHtml } from '../../lib/cmsHtml';

interface Props {
  bloque?: WebBloque | null;
}

const { bloque } = Astro.props;
if (!bloque) {
  return null;
}

const titleHtml = cmsTitleHtml(bloque.titulo) || cmsTitleHtml('Contáctanos');
const bodyHtml =
  cmsHtml(bloque.contenido || bloque.subtitulo) ||
  cmsHtml('Completa el formulario y atenderemos tu requerimiento lo más pronto posible.');
const extra = (bloque.extra && typeof bloque.extra === 'object' ? bloque.extra : {}) as Record<
  string,
  unknown
>;
/**
 * CMS (bloque contacto):
 * - Principal → persona PNG (bloque.url)
 * - Fondo     → paisaje (extra.fondo_url)
 * Legacy: si solo hay url y no fondo, url era el fondo.
 */
const fondoExtra = typeof extra.fondo_url === 'string' && extra.fondo_url ? extra.fondo_url : null;
const personaExtra =
  (typeof extra.persona_url === 'string' && extra.persona_url) ||
  (typeof extra.principal_url === 'string' && extra.principal_url) ||
  null;
const bg = fondoExtra || (!personaExtra ? bloque.url : null) || null;
const persona = personaExtra || (fondoExtra ? bloque.url : null);
const cta = bloque.cta_texto || 'Enviar';
const aria = cmsPlain(bloque.titulo) || 'Contáctanos';
---

<section
  id="contactanos"
  class="reveal-on-scroll relative w-full overflow-hidden border-b-[3px] border-cimak-yellow min-h-[420px] lg:min-h-[520px]"
  aria-label={aria}
>
  {bg ? (
    <img
      src={bg}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center"
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class="absolute inset-0 bg-[#e8eef5]" aria-hidden="true"></div>
  )}

  <div class="container-cimak relative z-10 min-h-[420px] lg:min-h-[520px]">
    {persona && (
      <div class="absolute bottom-0 left-1/2 z-20 hidden max-w-[42%] -translate-x-[72%] lg:block xl:-translate-x-[68%]">
        <img
          src={persona}
          alt="Asesor"
          class="block h-auto w-auto max-h-[min(580px,92vh)] translate-y-4 object-contain object-bottom drop-shadow-md"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <div class="flex min-h-[420px] items-center justify-center py-10 lg:min-h-[520px] lg:justify-end lg:py-12 lg:pr-4 xl:pr-10">
      <div
        class="relative z-10 w-full max-w-md rounded-2xl border border-white/50 bg-white/90 p-5 shadow-[0_12px_40px_rgba(0,0,0,0.18)] backdrop-blur-sm sm:p-6 lg:max-w-[490px]"
      >
      <div class="cms-prose cms-prose--title text-[1.4rem] font-extrabold leading-tight text-cimak-black sm:text-[1.55rem]" set:html={titleHtml} />
      <div
        class="cms-prose mt-1.5 text-[0.8rem] leading-snug text-cimak-black/85 sm:text-[0.875rem]"
        set:html={bodyHtml}
      />

      <form class="mt-4 flex flex-col gap-2.5" method="post" action="#">
        <label class="sr-only" for="contacto-nombre">Nombres y Apellidos</label>
        <input
          id="contacto-nombre"
          name="nombre"
          type="text"
          required
          placeholder="Nombres y Apellidos"
          class="w-full rounded-md border border-black/10 bg-white px-3.5 py-2.5 text-sm text-cimak-black outline-none placeholder:text-black/35 focus:border-cimak-yellow"
        />

        <label class="sr-only" for="contacto-email">Correo electrónico</label>
        <input
          id="contacto-email"
          name="email"
          type="email"
          required
          placeholder="Correo electrónico"
          class="w-full rounded-md border border-black/10 bg-white px-3.5 py-2.5 text-sm text-cimak-black outline-none placeholder:text-black/35 focus:border-cimak-yellow"
        />

        <label class="sr-only" for="contacto-telefono">Teléfono</label>
        <input
          id="contacto-telefono"
          name="telefono"
          type="tel"
          required
          placeholder="Teléfono"
          class="w-full rounded-md border border-black/10 bg-white px-3.5 py-2.5 text-sm text-cimak-black outline-none placeholder:text-black/35 focus:border-cimak-yellow"
        />

        <label class="sr-only" for="contacto-empresa">Empresa / RUC</label>
        <input
          id="contacto-empresa"
          name="empresa"
          type="text"
          placeholder="Empresa / RUC"
          class="w-full rounded-md border border-black/10 bg-white px-3.5 py-2.5 text-sm text-cimak-black outline-none placeholder:text-black/35 focus:border-cimak-yellow"
        />

        <label class="sr-only" for="contacto-mensaje">Mensaje</label>
        <textarea
          id="contacto-mensaje"
          name="mensaje"
          rows="3"
          required
          placeholder="Mensaje"
          class="w-full resize-y rounded-md border border-black/10 bg-white px-3.5 py-2.5 text-sm text-cimak-black outline-none placeholder:text-black/35 focus:border-cimak-yellow"
        ></textarea>

        <button
          type="submit"
          class="mt-0.5 w-fit rounded-md bg-cimak-yellow px-8 py-2.5 text-sm font-bold text-cimak-black transition hover:brightness-105"
        >
          {cta}
        </button>
      </form>
      </div>
    </div>
  </div>
</section>
