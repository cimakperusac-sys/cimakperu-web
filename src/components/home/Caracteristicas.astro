---
import type { WebBloque } from '../../lib/types/web';
import { cmsHtml, cmsPlain } from '../../lib/cmsHtml';

interface Props {
  bloque?: WebBloque | null;
}

type Feature = { title?: string; text?: string; icon_url?: string };

const { bloque } = Astro.props;
if (!bloque) {
  return null;
}

const extra = (bloque.extra && typeof bloque.extra === 'object' ? bloque.extra : {}) as Record<
  string,
  unknown
>;
const items: Feature[] = Array.isArray(extra.items) ? (extra.items as Feature[]) : [];

if (!items.length) {
  return null;
}

const sectionTitleHtml = cmsHtml(bloque.titulo);
const aria = cmsPlain(bloque.titulo) || 'Características';
---

<section
  id="caracteristicas"
  class="w-full bg-[#f3f3f3] pb-10 pt-6 sm:pb-16 sm:pt-4"
  aria-label={aria}
>
  <div class="container-cimak">
    {sectionTitleHtml && (
      <div class="reveal-on-scroll reveal-up cms-prose mb-6 text-center text-xl font-extrabold text-cimak-black sm:text-2xl" set:html={sectionTitleHtml} />
    )}
    <div class="reveal-stagger grid grid-cols-1 gap-4 sm:gap-5 md:grid-cols-3 md:gap-6 lg:gap-8" data-reveal-gap="100">
      {items.map((item) => (
        <div class="reveal-on-scroll reveal-rise reveal-item flex flex-col items-center rounded-2xl bg-cimak-black px-6 py-8 text-center text-white sm:px-7 sm:py-10">
          {item.icon_url ? (
            <img
              src={item.icon_url}
              alt=""
              class="mb-5 h-14 w-auto object-contain brightness-0 invert sm:h-16"
              width={80}
              height={80}
              loading="lazy"
              decoding="async"
              aria-hidden="true"
            />
          ) : null}
          {item.title && (
            <div class="cms-prose text-[0.95rem] font-bold leading-tight sm:text-base" set:html={cmsHtml(item.title)} />
          )}
          {item.text && (
            <div class="cms-prose mt-2 max-w-[260px] text-sm font-normal leading-snug text-white/95 sm:text-[0.95rem]" set:html={cmsHtml(item.text)} />
          )}
        </div>
      ))}
    </div>
  </div>
</section>
