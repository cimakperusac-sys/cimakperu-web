---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/logo.svg';
import { navLinks } from '../../data/navigation';
---

<header class="sticky top-0 z-50 w-full shadow-sm">
  <div class="bg-cimak-yellow">
    <div class="container-cimak flex items-center justify-between py-1.5 sm:py-2">
      <a href="/" class="shrink-0">
        <Image
          src={logo}
          alt="CIMAK PERU"
          width={72}
          height={26}
          class="h-5 w-auto sm:h-6"
          loading="lazy"
          decoding="async"
        />
      </a>

      <div class="flex items-center gap-3 text-cimak-black sm:gap-4">
        <button type="button" aria-label="Buscar" class="hover:opacity-70">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="sm:h-5 sm:w-5">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
        </button>

        <a href="/cuenta" aria-label="Cuenta" class="hover:opacity-70">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="sm:h-5 sm:w-5">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <nav class="bg-cimak-black text-cimak-white">
    <div class="container-cimak flex items-center justify-between gap-4 py-1.5 sm:py-2">
      <ul class="hidden md:flex flex-wrap items-center gap-5 text-xs tracking-wide lg:gap-7 lg:text-sm">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="hover:text-cimak-yellow transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        class="md:ml-auto text-cimak-white"
        aria-label="Abrir menú"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>
</header>
