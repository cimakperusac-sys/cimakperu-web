---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/logo.svg';
import { getMenuConFallback, familiaHref, productoHref } from '../../lib/catalogo';
import type { WebMenuFamilia } from '../../lib/types/web';

interface Props {
  menu?: WebMenuFamilia[];
}

const { menu: menuProp } = Astro.props;
const menu = menuProp?.length ? menuProp : await getMenuConFallback();

/** La barra negra muestra las primeras familias; el resto vive en el panel del hamburguesa. */
const principales = menu.slice(0, 4);
const rutaActual = Astro.url.pathname;

const esActiva = (familia: WebMenuFamilia) => {
  const href = familiaHref(familia);
  return href !== '/' && rutaActual.startsWith(href);
};
---

<header class="sticky top-0 z-50 w-full shadow-sm" data-site-header>
  <div class="bg-cimak-yellow">
    <div class="container-cimak flex items-center justify-between py-1.5 sm:py-2">
      <a href="/" class="shrink-0">
        <Image
          src={logo}
          alt="CIMAK PERU"
          width={72}
          height={26}
          class="h-5 w-auto sm:h-6"
          loading="lazy"
          decoding="async"
        />
      </a>

      <div class="flex items-center gap-1 text-cimak-black">
        <button
          type="button"
          aria-label="Buscar"
          class="inline-flex h-11 w-11 items-center justify-center hover:opacity-70"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="sm:h-5 sm:w-5">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
        </button>

        <a
          href="/cuenta"
          aria-label="Cuenta"
          class="inline-flex h-11 w-11 items-center justify-center hover:opacity-70"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="sm:h-5 sm:w-5">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <nav class="bg-cimak-black text-cimak-white" aria-label="Catálogo">
    <div class="container-cimak flex items-center justify-between gap-4">
      <ul class="hidden min-w-0 flex-wrap items-center gap-1 text-[0.7rem] font-semibold uppercase tracking-wide md:flex lg:gap-3 lg:text-xs">
        {principales.map((familia) => (
          <li class="relative">
            {familia.subcategorias.length > 0 ? (
              <details class="group" data-nav-details>
                <summary
                  class="flex cursor-pointer list-none items-center gap-1.5 px-2.5 py-3 transition-colors hover:text-cimak-yellow group-open:text-cimak-yellow lg:px-3"
                  aria-current={esActiva(familia) ? 'page' : undefined}
                >
                  <span>{familia.nombre}</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    class="h-3 w-3 shrink-0 transition-transform group-open:rotate-180"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>

                <div class="absolute left-0 top-full z-40 mt-0 w-[min(92vw,560px)] rounded-b-lg border-t-2 border-cimak-yellow bg-white p-4 text-cimak-black shadow-xl">
                  <a
                    href={familiaHref(familia)}
                    class="mb-3 inline-block text-[0.7rem] font-bold uppercase tracking-wide text-cimak-black hover:text-cimak-yellow"
                  >
                    Ver todo {familia.nombre} →
                  </a>
                  <div class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
                    {familia.subcategorias.map((sub) => (
                      <div>
                        <p class="text-[0.65rem] font-bold uppercase tracking-[0.12em] text-cimak-black/50">
                          {sub.nombre}
                        </p>
                        <ul class="mt-1.5 space-y-1">
                          {sub.productos.slice(0, 6).map((producto) => {
                            const href = productoHref(producto);
                            return href ? (
                              <li>
                                <a
                                  href={href}
                                  class="block py-0.5 text-[0.72rem] font-medium normal-case text-cimak-black/80 hover:text-cimak-yellow"
                                >
                                  {producto.nombre}
                                </a>
                              </li>
                            ) : null;
                          })}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </details>
            ) : (
              <a
                href={familiaHref(familia)}
                class="block px-2.5 py-3 transition-colors hover:text-cimak-yellow lg:px-3"
                aria-current={esActiva(familia) ? 'page' : undefined}
              >
                {familia.nombre}
              </a>
            )}
          </li>
        ))}
      </ul>

      <button
        type="button"
        id="site-menu-toggle"
        class="ml-auto inline-flex h-11 w-11 items-center justify-center text-cimak-white"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="site-menu-panel"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="site-menu-panel"
    class="hidden max-h-[75svh] overflow-y-auto overscroll-contain border-t border-white/10 bg-cimak-black text-white"
    data-lenis-prevent
  >
    <ul class="container-cimak divide-y divide-white/10 py-2">
      {menu.map((familia) => (
        <li>
          {familia.subcategorias.length > 0 ? (
            <details class="group" data-nav-details>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 py-3 text-sm font-bold uppercase tracking-wide">
                <span>{familia.nombre}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  class="h-4 w-4 shrink-0 text-cimak-yellow transition-transform group-open:rotate-180"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>

              <div class="pb-3">
                <a
                  href={familiaHref(familia)}
                  class="block py-2 text-xs font-bold uppercase tracking-wide text-cimak-yellow"
                >
                  Ver todo {familia.nombre}
                </a>
                {familia.subcategorias.map((sub) => (
                  <div class="mt-1">
                    <p class="pt-1 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-white/45">
                      {sub.nombre}
                    </p>
                    <ul>
                      {sub.productos.map((producto) => {
                        const href = productoHref(producto);
                        return href ? (
                          <li>
                            <a href={href} class="block py-2.5 text-sm text-white/85 hover:text-cimak-yellow">
                              {producto.nombre}
                            </a>
                          </li>
                        ) : null;
                      })}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          ) : (
            <a
              href={familiaHref(familia)}
              class="flex items-center py-3.5 text-sm font-bold uppercase tracking-wide hover:text-cimak-yellow"
            >
              {familia.nombre}
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');

  if (header) {
    const toggle = header.querySelector('#site-menu-toggle');
    const panel = header.querySelector('#site-menu-panel');
    const barDropdowns = [...header.querySelectorAll('nav [data-nav-details]')];

    const setPanel = (open) => {
      if (!toggle || !panel) return;
      panel.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };

    const closeBar = () => barDropdowns.forEach((item) => (item.open = false));

    toggle?.addEventListener('click', () => {
      const open = panel?.classList.contains('hidden') ?? false;
      setPanel(open);
      if (open) closeBar();
    });

    barDropdowns.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        barDropdowns.forEach((other) => {
          if (other !== item) other.open = false;
        });
        setPanel(false);
      });
    });

    document.addEventListener('click', (event) => {
      if (header.contains(event.target)) return;
      closeBar();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeBar();
      setPanel(false);
    });
  }
</script>

<style>
  [data-nav-details] > summary::-webkit-details-marker {
    display: none;
  }
</style>
