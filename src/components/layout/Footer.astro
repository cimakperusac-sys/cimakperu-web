---
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import logo from '../../assets/footer/logo.svg';
import libro from '../../assets/footer/libro.svg';
import terminos from '../../assets/footer/terminos.svg';
import politica from '../../assets/footer/politica.svg';
import facebook from '../../assets/footer/facebook.svg';
import instagram from '../../assets/footer/instagram.svg';
import tiktok from '../../assets/footer/tiktok.svg';
import whatsapp from '../../assets/footer/whatsapp.svg';

const servicios = [
  { label: 'Preguntas frecuentes', href: '/preguntas-frecuentes' },
  { label: 'Términos y condiciones', href: '/terminos' },
  { label: 'Políticas de privacidad', href: '/privacidad' },
] as const;

const secciones = [
  { label: 'Quiénes somos', href: '/#nosotros' },
  { label: 'Nuestras tiendas', href: '/tiendas' },
  { label: 'Blog', href: '/blog' },
] as const;

const legalButtons = [
  {
    label: ['Libro de', 'Reclamaciones'],
    href: '/libro-de-reclamaciones',
    icon: libro,
    iconClass: 'h-5 w-auto brightness-0 invert',
    width: 61,
    height: 25,
  },
  {
    label: ['Términos y', 'condiciones'],
    href: '/terminos',
    icon: terminos,
    iconClass: 'h-6 w-auto',
    width: 28,
    height: 34,
  },
  {
    label: ['Política de', 'privacidad'],
    href: '/privacidad',
    icon: politica,
    iconClass: 'h-6 w-auto',
    width: 28,
    height: 33,
  },
] as const;

const socials = [
  { label: 'Facebook', href: site.social.facebook, icon: facebook },
  { label: 'Instagram', href: site.social.instagram, icon: instagram },
  { label: 'TikTok', href: site.social.tiktok, icon: tiktok },
  { label: 'WhatsApp', href: site.social.whatsapp, icon: whatsapp },
] as const;
---

<footer class="bg-cimak-yellow text-cimak-black">
  <!-- Mobile -->
  <div class="container-cimak flex flex-col px-6 py-10 md:hidden">
    <div class="space-y-6 text-left">
      <div>
        <h3 class="text-base font-bold">Servicios al cliente</h3>
        <ul class="mt-2 space-y-1 text-sm">
          {
            servicios.map((item) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cimak-black" aria-hidden="true" />
                <a href={item.href} class="transition hover:opacity-70">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-base font-bold">Secciones</h3>
        <ul class="mt-2 space-y-1 text-sm">
          {
            secciones.map((item) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cimak-black" aria-hidden="true" />
                <a href={item.href} class="transition hover:opacity-70">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-base font-bold">Ubicación y Contacto:</h3>
        <ul class="mt-2 space-y-1 text-sm">
          <li class="flex gap-2">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cimak-black" aria-hidden="true" />
            <a href={site.phoneHref} class="transition hover:opacity-70">{site.phone}</a>
          </li>
          <li class="flex gap-2">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cimak-black" aria-hidden="true" />
            <a href={`mailto:${site.email}`} class="transition hover:opacity-70">{site.email}</a>
          </li>
          <li class="flex gap-2">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cimak-black" aria-hidden="true" />
            <span class="leading-snug">{site.address}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-6 h-[180px] w-full overflow-hidden rounded-xl">
      <iframe
        title="Ubicación CIMAK"
        src={site.mapEmbed}
        class="h-full w-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>

    <div class="mt-6 flex flex-col gap-3">
      {
        legalButtons.map((item) => (
          <a
            href={item.href}
            class="inline-flex items-center justify-center gap-3 rounded-xl bg-cimak-black px-5 py-3.5 text-white transition hover:opacity-90"
          >
            <Image
              src={item.icon}
              alt=""
              class={item.iconClass}
              width={item.width}
              height={item.height}
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
            <span class="text-left text-sm font-semibold leading-tight">
              {item.label[0]}
              <br />
              {item.label[1]}
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-center text-base font-bold">¡Mantente informado!</p>
    <div class="mt-3 flex items-center justify-center gap-3">
      {
        socials.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={item.label}
            class="flex h-10 w-10 items-center justify-center rounded-full bg-cimak-black transition hover:opacity-80"
          >
            <Image
              src={item.icon}
              alt=""
              class="h-5 w-5 brightness-0 invert"
              width={22}
              height={22}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>

    <div class="mt-8 flex flex-col items-center gap-3">
      <Image
        src={logo}
        alt="CIMAK"
        class="h-10 w-auto"
        width={89}
        height={34}
        loading="lazy"
        decoding="async"
      />
      <p class="max-w-xs text-center text-[0.7rem] leading-relaxed text-cimak-black/90">
        © {new Date().getFullYear()} {site.legalName} RUC: {site.ruc} | Todos los derechos
        reservados
      </p>
    </div>
  </div>

  <!-- Desktop -->
  <div class="container-cimak hidden py-10 md:block lg:py-12">
    <div class="flex items-start justify-between gap-8 lg:gap-12">
      <div class="grid flex-1 grid-cols-3 gap-6 lg:gap-10">
        <div>
          <h3 class="text-base font-bold">Servicios al cliente</h3>
          <ul class="mt-3 space-y-1.5 text-sm">
            {
              servicios.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cimak-black" aria-hidden="true" />
                  <a href={item.href} class="transition hover:opacity-70">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class="text-base font-bold">Secciones</h3>
          <ul class="mt-3 space-y-1.5 text-sm">
            {
              secciones.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cimak-black" aria-hidden="true" />
                  <a href={item.href} class="transition hover:opacity-70">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class="text-base font-bold">Ubicación y Contacto:</h3>
          <ul class="mt-3 space-y-1.5 text-sm">
            <li class="flex gap-2">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cimak-black" aria-hidden="true" />
              <a href={site.phoneHref} class="transition hover:opacity-70">
                {site.phone}
              </a>
            </li>
            <li class="flex gap-2">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cimak-black" aria-hidden="true" />
              <a href={`mailto:${site.email}`} class="transition hover:opacity-70">
                {site.email}
              </a>
            </li>
            <li class="flex gap-2">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cimak-black" aria-hidden="true" />
              <span class="leading-snug">{site.address}</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="h-[160px] w-[min(34%,340px)] shrink-0 overflow-hidden rounded-xl shadow-sm lg:h-[180px] lg:w-[min(32%,380px)]">
        <iframe
          title="Ubicación CIMAK"
          src={site.mapEmbed}
          class="h-full w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <div class="mt-8 flex items-center justify-between gap-6 lg:mt-10">
      <div class="flex flex-wrap items-center gap-3">
        {
          legalButtons.map((item) => (
            <a
              href={item.href}
              class="inline-flex items-center gap-2.5 rounded-lg bg-cimak-black px-4 py-2.5 text-white transition hover:opacity-90"
            >
              <Image
                src={item.icon}
                alt=""
                class={item.iconClass}
                width={item.width}
                height={item.height}
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <span class="text-left text-xs font-semibold leading-tight sm:text-sm">
                {item.label[0]}
                <br />
                {item.label[1]}
              </span>
            </a>
          ))
        }
      </div>

      <div class="flex shrink-0 flex-col items-end gap-2">
        <p class="text-sm font-bold sm:text-base">¡Mantente informado!</p>
        <div class="flex items-center gap-2.5">
          {
            socials.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
                class="flex h-9 w-9 items-center justify-center rounded-full bg-cimak-black transition hover:opacity-80"
              >
                <Image
                  src={item.icon}
                  alt=""
                  class="h-[18px] w-[18px] brightness-0 invert"
                  width={22}
                  height={22}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center gap-3 lg:mt-12">
      <Image
        src={logo}
        alt="CIMAK"
        class="h-9 w-auto sm:h-10"
        width={89}
        height={34}
        loading="lazy"
        decoding="async"
      />
      <p class="text-center text-[0.7rem] leading-relaxed text-cimak-black/90 sm:text-xs">
        © {new Date().getFullYear()} {site.legalName} RUC: {site.ruc} | Todos los derechos
        reservados
      </p>
    </div>
  </div>
</footer>
